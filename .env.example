# ──────────────────────────────────────────────────────────────
# Sendves environment variables (phase 2)
# Copy any NEW variables into your existing .env.local.
# ──────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@sendves.com

# Domains. The admin console is served ONLY at admin.<root domain> (never under /admin).
# Production: NEXT_PUBLIC_ROOT_DOMAIN=sendves.com  ->  admin.sendves.com
# Local: leave unset; open http://admin.localhost:3000 (browsers resolve *.localhost to your machine).
NEXT_PUBLIC_ROOT_DOMAIN=
# Optional, defaults to "admin".
NEXT_PUBLIC_ADMIN_SUBDOMAIN=admin

# Marketing only: shows placeholder stats/testimonials on the landing page. Keep "false" in production.
NEXT_PUBLIC_SAMPLE_DATA=false

# Admin console security
# Admins must pass TOTP two-factor sign-in. Only set to "false" for local development.
ADMIN_REQUIRE_MFA=true
# Optional comma-separated IP allowlist for the admin host, e.g. 203.0.113.4,198.51.100.7
ADMIN_ALLOWED_IPS=

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# REQUIRED in phase 2: every write and the sending worker use this. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Secrets (generate with: openssl rand -hex 32)
# Signs unsubscribe, open and click links. Changing it breaks links in emails already sent.
APP_SECRET=
# Protects /api/cron/tick (min. 16 chars). Send it as "Authorization: Bearer <CRON_SECRET>"; it is no longer accepted in the URL.
CRON_SECRET=

# Team invitations are emailed from this address (a verified identity in your email provider), e.g.
# Sendves <no-reply@sendves.com>. Optional: without it the Team page shows the invite link to copy.
PLATFORM_FROM_EMAIL=

# Sending
# "console" prints emails to the terminal (safe for development). "ses" sends through Amazon SES.
SENDING_PROVIDER=console
SEND_RATE_PER_SECOND=5
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# SES configuration set that publishes events to your SNS topic
SES_CONFIGURATION_SET=
# Shared secret added to the SNS subscription URL: https://yourdomain/api/webhooks/ses?secret=...
# SNS message signatures are now verified as well, so a leaked URL alone can't forge events.
SES_WEBHOOK_SECRET=
# Recommended: only accept messages from this SNS topic
SES_SNS_TOPIC_ARN=

# Billing (fill in whichever provider you enable)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
PAYSTACK_SECRET_KEY=
# Amounts are in the smallest currency unit (kobo for NGN)
PAYSTACK_AMOUNT_STARTER=
PAYSTACK_AMOUNT_GROWTH=
# Optional Paystack plan codes for recurring billing
PAYSTACK_PLAN_STARTER=
PAYSTACK_PLAN_GROWTH=
